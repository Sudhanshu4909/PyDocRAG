# Environment
ENV=development
DEBUG=true

# Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=python_docs
# QDRANT_API_KEY=  # For Qdrant Cloud

# Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# LLM Configuration
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
LLM_BASE_URL=http://localhost:11434
# LLM_API_KEY=  # For OpenAI/Anthropic

# Redis Cache
REDIS_URL=redis://localhost:6379
ENABLE_CACHE=true
CACHE_TTL=3600

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Retrieval
DEFAULT_TOP_K=5
ENABLE_RERANKING=true

# Monitoring
ENABLE_METRICS=true
LOG_LEVEL=INFO

# Data Collection
DOCS_OUTPUT_DIR=data/python_docs
MAX_PAGES_PER_LIBRARY=100
